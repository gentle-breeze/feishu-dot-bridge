{
  "version": 1,
  "socketPath": "/absolute/private-directory/bridge.sock",
  "jobs": [{
    "id": "daily-review",
    "type": "review-summary-v1",
    "enabled": false,
    "time": "20:00",
    "timezone": "Asia/Shanghai",
    "bindingId": "REPLACE_WITH_VERIFIED_OWNER_BINDING",
    "authorizationReference": null,
    "target": {"repository": "/absolute/commit-review", "remote": "https://github.com/gentle-breeze/commit-review.git", "branch": "main", "files": [".claude/skills/review-comments/SKILL.md"]},
    "parameters": {
      "sources": [{"file": "/absolute/commit-review/.reviews/REPLACE/comments.json", "repository": "/absolute/reviewed-repository"}],
      "historyDays": 7,
      "maxComments": 20
    }
  }]
}
